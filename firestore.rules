rules_version = '2';

// ERA Sanitary — Firestore security rules.
//
// This file is a RECORD of what is published in the console, not the source of
// truth: the site is static and has no Firebase CLI deploy step, so the live
// rules are whatever was last pasted into Firebase Console → Build → Firestore
// Database → Rules. Change the console first, then bring this file into line —
// never the other way round, or the next person to paste this reverts the
// hardening below without noticing.
//
// WHAT IS LIVE IS THIS FILE WITH THE COMMENTS STRIPPED — 70 lines of rules;
// this file is longer only because of the explanations. Every rule is
// identical. So do not diff the console against this file and conclude it has
// drifted. Compare the `allow`, `match` and `function` lines instead: there
// are 8, 4 and 3 of them, and they match. (Not this file's own line count —
// that moves every time someone writes a comment, as it just did.)
//
// It was shortened at the console end because pasting 174 lines into that
// editor failed twice. The Firebase rules editor is embedded in the page, so
// Ctrl+A selects the whole PAGE unless the cursor is already inside the code —
// the delete then silently does nothing and the paste lands beside the old
// rules instead of replacing them. It compiles as one long broken file and
// reports an error on a line number past the end of what you pasted, which is
// the tell. Less text is less to mishandle.
//
// The comments stay here because they are the reasoning, and the reasoning is
// the part worth keeping — above all why isOwner() checks a UID allowlist
// rather than `request.auth != null`.
//
// The intent: anyone on the website can SUBMIT a quote request, but only the
// signed-in owner can READ one. A lead holds a customer's name and phone number,
// so it must never be publicly readable.

service cloud.firestore {
  match /databases/{database}/documents {

    // Which accounts may read the leads, by UID.
    //
    // NOT `request.auth != null`. The web API key is public by design — it is in
    // the page source of every visitor — and with Email/Password sign-in enabled
    // anyone can create an account in this project for themselves. An auth check
    // alone therefore means "any stranger who signed up", which is no boundary at
    // all. The sister project learned this the hard way: its rules once accepted
    // any signed-in account and handed every patient name and phone number to
    // anyone who asked, over REST.
    //
    // UIDs and not emails, because this list is mirrored in the dashboard's own
    // config, which is served publicly. A UID identifies the account without
    // being contact details.
    //
    // Add a UID from Firebase Console → Authentication → Users. An empty list
    // means NOBODY can read the leads — which is the safe way to be wrong.
    function isOwner() {
      return request.auth != null
        && request.auth.uid in [
             '4VNXgYEnJTfRYci0PGqXAGQHReC3'   // shop owner
           ];
    }

    // Guards the one collection the public can write to.
    //
    // Without this, anyone who reads the project ID out of the page source could
    // write 1 MiB documents until the Spark plan's 20,000 daily writes are gone,
    // at which point real quote requests start failing — silently, because
    // recordQuote() in main.js swallows its errors so that a recording failure
    // can never break the WhatsApp hand-off. That same silence means a rule that
    // is too STRICT also loses leads with nothing shown on screen and nothing in
    // the console. After editing this function, submit a real quote request and
    // look in Firestore before trusting it.
    //
    // `status` and `source` are pinned rather than accepted: a submission is
    // always a new website lead, and the dashboard is what moves it along.
    //
    // createdAt is a client ISO string, not request.time. The REST API cannot
    // set a server timestamp without a transform commit, and the site posts over
    // REST to avoid loading the Firebase SDK on a public page.
    //
    // So this value comes from the visitor's device and a wrong clock gives a
    // wrong time. The dashboard orders by it anyway — ISO 8601 sorts correctly as
    // plain text — because the alternative is not available: Firestore sets a
    // server-side createTime on every document, but the JavaScript SDK does not
    // expose it on a snapshot, only the REST API returns it. A lead from a device
    // with a bad clock therefore sorts to the wrong place in the list. That is
    // the whole cost, and it is worth less than the SDK would cost the site.
    function validLead(d) {
      return d.keys().hasOnly([
               'name','phone','category','items','lang','page',
               'status','source','createdAt'
             ])
        && d.name is string     && d.name.size() <= 100
        && d.phone is string    && d.phone.size() <= 30
        && d.category is string && d.category.size() <= 120
        && d.items is string    && d.items.size() <= 2000
        && d.lang is string     && d.lang.size() <= 8
        && d.page is string     && d.page.size() <= 200
        && d.status == 'new'
        && d.source == 'website'
        && d.createdAt is string && d.createdAt.size() <= 30;
    }

    match /leads/{leadId} {
      // A visitor submitting the quote form on contact.html, in either language.
      allow create: if validLead(request.resource.data);

      // Leads hold names and phone numbers. Owner only.
      allow read: if isOwner();

      // The dashboard moves a lead along: new → called → quoted → won / lost.
      // Only the status may change, and only to one of those values — so a
      // compromised dashboard session cannot rewrite what the customer asked for.
      allow update: if isOwner()
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status'])
        && request.resource.data.status in ['new','called','quoted','won','lost'];

      // Nothing deletes a lead from the web. An enquiry that arrived is a record
      // of a real customer asking for a price, and losing one to a stray tap is
      // worse than keeping one too many.
      allow delete: if false;
    }

    // A job: one piece of work or one sale, with what it came to and what has
    // been paid against it. This is where the shop's money lives.
    //
    // The validation below is a sanity check, NOT a trust boundary, and that is
    // the whole difference from validLead() above. A lead arrives from an
    // anonymous stranger, so its shape is the only thing standing between the
    // collection and a script filling it with megabytes; the caps there are
    // load-bearing. A job can only be written by a signed-in owner, so these
    // caps exist to catch a bug in the dashboard, not an attacker. That is why
    // the payments list is checked for being a list of sane length and not
    // field-by-field: the cost of being wrong is one malformed row the owner
    // can fix, not a public write hole.
    //
    // Every key is required as well as allowed (hasAll + hasOnly), because the
    // dashboard always writes the whole document and a half-written job with no
    // total is worse than a rejected write.
    //
    // `paid` and `due` are deliberately absent. paid is the sum of payments and
    // due is total minus paid, both computed when drawn. Storing either invites
    // the one bug this model makes impossible: a stored figure that disagrees
    // with the payment log it came from.
    function validJob(d) {
      return d.keys().hasAll([
               'name','phone','address','customerId','jobType','jobTypeLabel',
               'items','notes','total','payments','visitDate','nextDate',
               'createdAt','updatedAt','deletedAt','leadId'
             ])
        && d.keys().hasOnly([
               'name','phone','address','customerId','jobType','jobTypeLabel',
               'items','notes','total','payments','visitDate','nextDate',
               'createdAt','updatedAt','deletedAt','leadId'
             ])
        && d.name is string          && d.name.size() <= 100
        && d.phone is string         && d.phone.size() <= 30
        && d.address is string       && d.address.size() <= 200
        && d.customerId is string    && d.customerId.size() <= 24
        && d.jobType is string       && d.jobType.size() <= 60
        && d.jobTypeLabel is string  && d.jobTypeLabel.size() <= 120
        && d.items is string         && d.items.size() <= 2000
        && d.notes is string         && d.notes.size() <= 2000
        && d.total is number         && d.total >= 0 && d.total <= 100000000
        && d.payments is list        && d.payments.size() <= 60
        && d.visitDate is string     && d.visitDate.size() <= 10
        && d.nextDate is string      && d.nextDate.size() <= 10
        && d.createdAt is string     && d.createdAt.size() <= 30
        && d.updatedAt is string     && d.updatedAt.size() <= 30
        && d.deletedAt is string     && d.deletedAt.size() <= 30
        && d.leadId is string        && d.leadId.size() <= 40;
    }

    match /jobs/{jobId} {
      // Owner only, for reading AND writing. There is no public create path here
      // and there must never be one. A lead is a stranger asking for a price; a
      // job is a named customer, their address, and what they owe. The quote
      // form posts leads from an unauthenticated page, so if `jobs` ever gained
      // a public create rule the same route would publish the shop's debtors.
      allow read: if isOwner();
      allow create, update: if isOwner() && validJob(request.resource.data);

      // Unlike a lead, a job can really be deleted — but the dashboard routes
      // an owner's delete through the `deletedAt` bin so a stray tap on a phone
      // is recoverable, and only purges what has sat there past the configured
      // window. This rule is what lets that purge actually remove the row.
      allow delete: if isOwner();
    }

    // Nothing else in the project is reachable from the web client.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
